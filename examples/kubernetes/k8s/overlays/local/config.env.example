# Copy to config.env (git-ignored) and fill in. These become the pod's environment variables.
# Get the key and the integration ID from the Token Vault console: register an agent
# (type Service), connect Slack, and grant the agent "Post a message" on SLACK_CHANNEL.
DATABASE_URL=postgres://orders:orders@db.databases.svc:5432/orders
TOKEN_VAULT_API_KEY=tvak_xxxxxxxxxxxx_replace-with-the-agent-key
SLACK_INTEGRATION_ID=int_replace_me
SLACK_CHANNEL=C0123456789
