# Reference only. Run `npm run setup` to generate server/.env and webhook/.env with random values.
# --- server/.env (control plane) ---
PORT=4000
WEBHOOK_SIGNING_SECRET=<random 32+ byte secret, identical in both files>
DEFAULT_WEBHOOK_URL=http://localhost:4100
HEARTBEAT_INTERVAL_MS=30000
AUDIT_SIGNING_KEY=<random 32+ byte secret; control plane only, never in the database>
DATABASE_URL=postgres://token_vault:token_vault@localhost:5432/token_vault
CMS_CATALOG_URL=http://localhost:4200/catalog/v1
CMS_PUBLIC_KEY=<the CMS Ed25519 public key PEM with \n escapes (several concatenated during a key rotation); written by npm run setup>
# --- webhook/.env (customer vault runtime) ---
PORT=4100
WEBHOOK_SIGNING_SECRET=<same as above>
VAULT_ENCRYPTION_KEY=<base64 of 32 random bytes; customer-side only>
WEBHOOK_INSTANCE_ID=whi_local_customer_vault
WEBHOOK_DATABASE_URL=postgres://token_vault_customer:token_vault_customer@localhost:5432/token_vault_customer
GITHUB_MODE=mock
CMS_CATALOG_URL=http://localhost:4200/catalog/v1
CMS_PUBLIC_KEY=<same public key; the webhook verifies the catalog itself>
# Optional, only for GitHub App integrations whose key lives on the webhook (inject as a secret):
# GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app.pem
# GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# --- cms/api/.env (provider CMS) ---
PORT=4200
CMS_DATABASE_URL=postgres://token_vault_cms:token_vault_cms@localhost:5432/token_vault_cms
CMS_SIGNING_PRIVATE_KEY=<Ed25519 private key PEM with \n escapes; CMS only>
