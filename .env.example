# Reference only. Run `npm run setup` to generate server/.env and webhook/.env with random values.
# --- server/.env (control plane) ---
PORT=4000
WEBHOOK_SIGNING_SECRET=<random 32+ byte secret, identical in both files>
DEFAULT_WEBHOOK_URL=http://localhost:4100
HEARTBEAT_INTERVAL_MS=30000
DATABASE_URL=postgres://token_vault:token_vault@localhost:5432/token_vault
# --- webhook/.env (customer vault runtime) ---
PORT=4100
WEBHOOK_SIGNING_SECRET=<same as above>
VAULT_ENCRYPTION_KEY=<base64 of 32 random bytes; customer-side only>
WEBHOOK_INSTANCE_ID=whi_local_customer_vault
GITHUB_MODE=mock
